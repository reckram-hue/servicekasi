# DATABASE_URL: your Postgres connection string.
DATABASE_URL="postgresql://user:password@localhost:5432/servicekasi"

# Cloudflare R2 (job-site photos and client signatures). All five must be set
# together, or none — leaving them unset stores uploads in ./public/uploads
# instead, which is fine for local development but never for production
# (those files vanish on every deploy).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL="" # e.g. https://pub-xxxxxxxx.r2.dev (no trailing slash)

# Online payments
# Encrypts each business's payment provider keys in the database. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PAYMENT_SECRETS_KEY=""
# The public address PayFast calls back to confirm payments (e.g. your domain or a tunnel URL, no trailing slash).
# Leave empty to use the address the page was opened on.
PUBLIC_APP_URL=""
